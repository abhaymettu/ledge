{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ledge-notify needs_you --tone warn"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ledge-approve",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
